# Copy to .env.local for development and set real values in your deployment
# environment. NEVER commit .env.local — it is gitignored.

# NextAuth — MUST be a long random string in production (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=change-me-generate-a-32-byte-random-secret
NEXTAUTH_URL=http://localhost:3000

# Duende IdentityService (token issuer)
ID_URL=http://localhost:5000

# API gateway (YARP) base — trailing slash required
API_URL=http://localhost:6001/

# SignalR notification hub (routed through the gateway)
NEXT_PUBLIC_NOTIFY_URL=http://localhost:6001/notifications

# Paystack PUBLISHABLE key (browser-safe; used by the escrow checkout widget).
# Get it from dashboard.paystack.com. The SECRET key is NOT here — it belongs in
# the BiddingService (dotnet user-secrets set "Payments:Paystack:SecretKey" ...).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
NEXT_PUBLIC_PAYSTACK_CURRENCY=GHS

# OAuth client secret for the `nextApp` client. Must match
# IdentityServer__Clients__nextApp__Secret on the IdentityService.
# (NextAuth reads this via the provider config; keep it out of source.)
# NEXTAUTH_CLIENT_SECRET=change-me
