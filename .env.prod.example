# Production secrets for docker-compose.prod.yml.
# Copy to `.env` alongside the compose files (or load into your secret store).
# Generate strong random values — never reuse the development defaults.

# Databases
POSTGRES_PASSWORD=change-me-strong-random
MONGO_USER=root
MONGO_PASSWORD=change-me-strong-random

# IdentityServer OIDC client secret for the Next.js app.
# Must equal NEXTAUTH_CLIENT_SECRET in the frontend environment.
IDS_NEXTAPP_SECRET=change-me-strong-random

# Google sign-in (OPTIONAL). Create an OAuth 2.0 "Web application" client at
# console.cloud.google.com → APIs & Services → Credentials. Authorized redirect
# URI must be:  https://<your-identity-host>/signin-google
# Leave both blank to disable Google sign-in (the button simply won't appear).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IdentityServer token-signing certificate (PKCS#12 .pfx).
# Generate: openssl req -x509 -newkey rsa:2048 -keyout k.pem -out c.pem -days 825 -nodes \
#   && openssl pkcs12 -export -inkey k.pem -in c.pem -out signing.pfx
IDS_SIGNING_CERT_PATH=/run/secrets/identity-signing.pfx
IDS_SIGNING_CERT_PASSWORD=change-me-if-pfx-is-password-protected

# Bid-ledger RSA private key (PEM). ALL bidding-svc instances must share this key
# or cross-instance signature verification will fail. Generate:
#   openssl genrsa 2048
BID_LEDGER_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Escrow payment provider: Stripe | Paystack (or omit for the dev simulation,
# which is refused outside Development).
PAYMENTS_PROVIDER=Paystack
# Paystack secret key (from dashboard.paystack.com → Settings → API Keys).
PAYSTACK_SECRET_KEY=sk_live_or_test_change-me
PAYSTACK_CURRENCY=GHS
