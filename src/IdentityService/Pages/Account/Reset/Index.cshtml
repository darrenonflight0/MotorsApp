@page
@model IdentityService.Pages.Account.Reset.Index

@{
    ViewData["Title"] = "Reset password";
}

<h1>Choose a new password</h1>
<p class="sub">Passwords need 10+ characters with upper, lower, number and symbol.</p>

@if (Model.Done)
{
    <div class="notice">Password updated. You can sign in with your new password.</div>
    <div class="links">
        <a asp-page="/Account/Login/Index">Go to sign in</a>
    </div>
}
else
{
    <form method="post">
        <input type="hidden" asp-for="Input.Email" />
        <input type="hidden" asp-for="Input.Token" />

        <label asp-for="Input.Password">New password</label>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" autofocus />

        <label asp-for="Input.ConfirmPassword">Confirm new password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />

        <div asp-validation-summary="All" class="error"></div>

        <button type="submit">Reset password</button>
    </form>
}
